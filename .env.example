# Port du serveur
PORT=4000

# ===================== Fournisseurs IA =====================
# Chat : OpenRouter (compatible OpenAI, nombreux modèles dont gratuits)
#   https://openrouter.ai/settings/keys  (clé : sk-or-...)
OPENROUTER_API_KEY=

# Embeddings : Gemini (clé : AQ.Ab8... / AIza...)
#   utilisé pour les embeddings si défini, sinon on retombe sur OPENAI_API_KEY
GEMINI_API_KEY=

# Base « classique » (OpenAI / Groq / Mistral / LiteLLM / Ollama local…)
#   si OPENROUTER_API_KEY est vide, le chat utilise cette base
#   si GEMINI_API_KEY est vide , les embeddings utilisent cette base
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Modèles (adapter selon le fournisseur)
EMBED_MODEL=gemini-embedding-2
CHAT_MODEL=openai/gpt-4o-mini

# ===================== Stripe (paiement) =====================
# Optionnel pour le MVP — sans ces clés, le bouton « Mode démo » active l'illimité.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Secret du webhook Stripe (pour renouvellement/annulation auto d'abonnement)
STRIPE_WEBHOOK_SECRET=